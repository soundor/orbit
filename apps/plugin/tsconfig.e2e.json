{
  // The end-to-end tests and what serves them: Node, beside the browser or
  // the VST3 host, not in the plugin's runtime.
  "compilerOptions": {
    "target": "ES2023",
    // Node implements WebAssembly; TypeScript declares its value in DOM.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  },
  "include": ["e2e", "scripts", "playwright.config.ts"]
}
